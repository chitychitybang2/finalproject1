                                       <xAxis><CategoryAxis animated="false" label="Weeks Ahead" side="BOTTOM" style="-fx-tick-label-fill: #1D1D1F; -fx-font-size: 11px; -fx-font-weight: bold;" tickLabelFill="#1D1D1F" /></xAxis>
                                       <yAxis><NumberAxis animated="false" forceZeroInRange="false" label="Weight (kg)" side="LEFT" style="-fx-tick-label-fill: #1D1D1F; -fx-font-size: 11px; -fx-font-weight: bold;" tickLabelFill="#1D1D1F" /></yAxis>
                                    </LineChart>
                                    
                                    <VBox fx:id="vboxScaleDetails" spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 14; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2);">
                                       <children>
                                          <Label style="-fx-text-fill: #1D1D1F; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 0 0 4 0;" text="Projected Trend Weight Details" />
                                          <VBox fx:id="vboxScaleDetailsList" spacing="8.0" />
                                       </children>
                                    </VBox>
                                 </children>
                              </VBox>
                           </children>
                        </VBox>

                        <!-- Right Column: Stats and Action -->
                        <VBox prefWidth="340.0" spacing="12.0">
