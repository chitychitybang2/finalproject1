                              <!-- Goal Summary Metrics -->
                              <HBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 16; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2);">
                                 <children>
                                    <VBox alignment="CENTER" spacing="4.0" HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label fx:id="lblSummaryLoss" style="-fx-text-fill: #1D1D1F; -fx-font-size: 20px; -fx-font-weight: 800;" text="1.5 kg" />
                                          <Label style="-fx-text-fill: #8E8E93; -fx-font-size: 11px;" text="Weight loss" />
                                       </children>
                                    </VBox>
                                    <VBox prefWidth="1.0" style="-fx-background-color: #EEEEF0;" />
                                    <VBox alignment="CENTER" spacing="4.0" HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label fx:id="lblSummaryDays" style="-fx-text-fill: #1D1D1F; -fx-font-size: 20px; -fx-font-weight: 800;" text="28 days" />
                                          <Label style="-fx-text-fill: #8E8E93; -fx-font-size: 11px;" text="Duration" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                              
                              <!-- Today's Workout Card -->
                              <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 16; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2);">
                                 <children>
                                    <HBox alignment="CENTER_LEFT">
                                       <children>
                                          <Label style="-fx-text-fill: #8E8E93; -fx-font-size: 12px; -fx-font-weight: 700;" text="TODAY'S WORKOUT" />
                                          <HBox HBox.hgrow="ALWAYS" />
                                          <Label style="-fx-text-fill: #FF9500; -fx-font-size: 15px; -fx-font-weight: 800;" text="122 kcal" />
                                       </children>
                                    </HBox>
                                    <VBox spacing="2.0">
                                       <children>
                                          <Label style="-fx-text-fill: #1D1D1F; -fx-font-size: 15px; -fx-font-weight: 700;" text="Whole body / Abs &amp; Glutes" />
                                          <Label style="-fx-text-fill: #8E8E93; -fx-font-size: 12px;" text="Difficulty: L1 Beginner" />
                                       </children>
                                    </VBox>
                                 </children>
                              </VBox>

                              <HBox VBox.vgrow="ALWAYS" />

                              <HBox spacing="12.0">
                                 <children>
                                    <Button onAction="#handleBackTo4" prefHeight="48.0" prefWidth="120.0" style="-fx-background-color: #E5E5EA; -fx-text-fill: #1D1D1F; -fx-background-radius: 12; -fx-font-weight: 700; -fx-cursor: hand;" text="BACK" />
                                    <Button maxWidth="Infinity" onAction="#handleFinishWizard" prefHeight="48.0" style="-fx-background-color: #30D158; -fx-text-fill: white; -fx-background-radius: 12; -fx-font-weight: 700; -fx-cursor: hand;" text="SAVE &amp; ACTIVATE" HBox.hgrow="ALWAYS" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </children>
            </VBox>
            
         </children>
      </StackPane>
   </children>
</AnchorPane>
