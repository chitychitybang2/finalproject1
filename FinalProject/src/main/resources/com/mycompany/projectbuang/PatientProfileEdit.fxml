<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="760.0" prefWidth="880.0" style="-fx-background-color: #F5F5F7; -fx-font-family: '.AppleSystemUIFont', 'SF Pro', sans-serif;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.projectbuang.PatientProfileEditController">
   <children>
      <VBox spacing="16.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <padding>
            <Insets bottom="16.0" left="20.0" right="20.0" top="16.0" />
         </padding>
         <children>
            <!-- Top Header Navigation -->
            <HBox alignment="CENTER_LEFT" spacing="12.0">
               <children>
                  <Button onAction="#handleClose" style="-fx-background-color: #E5E5EA; -fx-text-fill: #1D1D1F; -fx-background-radius: 20; -fx-min-width: 40px; -fx-min-height: 40px; -fx-font-size: 16px; -fx-font-weight: bold; -fx-cursor: hand;" text="‹" />
                  <Label style="-fx-text-fill: #1D1D1F; -fx-font-size: 20px; -fx-font-weight: 700;" text="Profile" />
                  <HBox HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
            
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
               <content>
                  <StackPane alignment="TOP_CENTER" style="-fx-background-color: transparent; -fx-padding: 10 0 20 0;">
                     <children>
                        <!-- Form Card Container -->
                        <VBox spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 32; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.02), 12, 0, 0, 4); -fx-max-width: 540.0;">
                           <children>
                              <!-- Full Name -->
                              <VBox spacing="6.0">
                                 <children>
                                    <Label style="-fx-font-size: 14px; -fx-font-weight: 700; -fx-text-fill: #1D1D1F;" text="Full Name" />
                                    <TextField fx:id="txtFullName" promptText="Enter full name" style="-fx-background-color: #F5F5F7; -fx-background-radius: 10; -fx-padding: 12 16 12 16; -fx-font-size: 14px; -fx-text-fill: #1D1D1F; -fx-border-color: transparent;" />
                                 </children>
                              </VBox>
                              
                              <!-- Age -->
                              <VBox spacing="6.0">
                                 <children>
                                    <Label style="-fx-font-size: 14px; -fx-font-weight: 700; -fx-text-fill: #1D1D1F;" text="Age" />
                                    <TextField fx:id="txtAge" promptText="Enter age" style="-fx-background-color: #F5F5F7; -fx-background-radius: 10; -fx-padding: 12 16 12 16; -fx-font-size: 14px; -fx-text-fill: #1D1D1F; -fx-border-color: transparent;" />
                                 </children>
                              </VBox>
                              
                              <!-- Gender -->
                              <VBox spacing="6.0">
                                 <children>
                                    <Label style="-fx-font-size: 14px; -fx-font-weight: 700; -fx-text-fill: #1D1D1F;" text="Gender" />
                                    <ComboBox fx:id="comboGender" promptText="Select gender" style="-fx-background-color: #F5F5F7; -fx-background-radius: 10; -fx-padding: 4 8 4 8; -fx-font-size: 14px; -fx-text-fill: #1D1D1F; -fx-max-width: Infinity; -fx-border-color: transparent;" />
                                 </children>
                              </VBox>
                              
                              <!-- Blood Type -->
                              <VBox spacing="6.0">
                                 <children>
                                    <Label style="-fx-font-size: 14px; -fx-font-weight: 700; -fx-text-fill: #1D1D1F;" text="Blood Type" />
                                    <ComboBox fx:id="comboBloodType" promptText="Select blood type" style="-fx-background-color: #F5F5F7; -fx-background-radius: 10; -fx-padding: 4 8 4 8; -fx-font-size: 14px; -fx-text-fill: #1D1D1F; -fx-max-width: Infinity; -fx-border-color: transparent;" />
                                 </children>
                              </VBox>
                              
                              <!-- Phone -->
                              <VBox spacing="6.0">
                                 <children>
                                    <Label style="-fx-font-size: 14px; -fx-font-weight: 700; -fx-text-fill: #1D1D1F;" text="Phone" />
                                    <TextField fx:id="txtPhone" promptText="(+63)912-123-1234" style="-fx-background-color: #F5F5F7; -fx-background-radius: 10; -fx-padding: 12 16 12 16; -fx-font-size: 14px; -fx-text-fill: #1D1D1F; -fx-border-color: transparent;" />
                                 </children>
                              </VBox>
                              
                              <!-- Email -->
                              <VBox spacing="6.0">
                                 <children>
                                    <Label style="-fx-font-size: 14px; -fx-font-weight: 700; -fx-text-fill: #1D1D1F;" text="Email" />
                                    <TextField fx:id="txtEmail" promptText="lanzarpogi@gmail.com" style="-fx-background-color: #F5F5F7; -fx-background-radius: 10; -fx-padding: 12 16 12 16; -fx-font-size: 14px; -fx-text-fill: #1D1D1F; -fx-border-color: transparent;" />
                                 </children>
                              </VBox>
                              
                              <!-- Address -->
                              <VBox spacing="6.0">
                                 <children>
                                    <Label style="-fx-font-size: 14px; -fx-font-weight: 700; -fx-text-fill: #1D1D1F;" text="Address" />
                                    <TextField fx:id="txtAddress" promptText="Enter address" style="-fx-background-color: #F5F5F7; -fx-background-radius: 10; -fx-padding: 12 16 12 16; -fx-font-size: 14px; -fx-text-fill: #1D1D1F; -fx-border-color: transparent;" />
                                 </children>
                              </VBox>
                              
                              <!-- Actions Spacer -->
                              <VBox spacing="10.0" style="-fx-padding: 10 0 0 0;">
                                 <children>
                                    <HBox alignment="CENTER_RIGHT" spacing="12.0">
                                       <children>
                                          <Button onAction="#handleClose" style="-fx-background-color: white; -fx-border-color: #D1D1D6; -fx-border-radius: 8; -fx-background-radius: 8; -fx-text-fill: #1D1D1F; -fx-padding: 10 24 10 24; -fx-font-weight: 600; -fx-font-size: 14px; -fx-cursor: hand;" text="Cancel" />
                                          <Button onAction="#handleSave" style="-fx-background-color: #1D1D1F; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 28 10 28; -fx-font-weight: 600; -fx-font-size: 14px; -fx-cursor: hand;" text="Save" />
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>
                           </children>
                        </VBox>
                     </children>
                  </StackPane>
               </content>
            </ScrollPane>
         </children>
      </VBox>
   </children>
</AnchorPane>
